{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "msedge",
      "request": "launch",
      "name": "Launch Edge with Vite Dev Server",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "npm: dev",
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${workspaceFolder}/src/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///src/*": "${workspaceFolder}/src/*",
        "webpack:///*": "*",
        "/./*": "${workspaceFolder}/*",
        "/src/*": "${workspaceFolder}/src/*",
        "ladrillosjs/*": "${workspaceFolder}/src/*",
        "../*": "${workspaceFolder}/*",
        "./*": "${workspaceFolder}/*"
      },
      "pathMapping": {
        "/src": "${workspaceFolder}/src",
        "/": "${workspaceFolder}"
      },
      "sourceMaps": true,
      "smartStep": true,
      "trace": true,
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**",
        "${workspaceFolder}/node_modules/**"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Launch Edge (Manual Start)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${workspaceFolder}/src/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///src/*": "${workspaceFolder}/src/*",
        "webpack:///*": "*",
        "/./*": "${workspaceFolder}/*"
      },
      "pathMapping": {
        "/src": "${workspaceFolder}/src"
      },
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**",
        "${workspaceFolder}/node_modules/**"
      ]
    }
  ]
}