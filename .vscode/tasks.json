{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "group": "build",
      "label": "npm: dev",
      "detail": "Start Vite development server with source maps",
      "isBackground": true,
      "options": {
        "env": {
          "NODE_ENV": "development"
        }
      },
      "problemMatcher": {
        "owner": "vite",
        "source": "vite",
        "fileLocation": "relative",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*vite",
          "endsPattern": "ready in|Local:.*http://localhost"
        },
        "pattern": [
          {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error)\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      }
    }
  ]
}
