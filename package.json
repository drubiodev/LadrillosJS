{
  "name": "ladrillosjs",
  "version": "2.0.0",
  "description": "A lightweight, zero-dependency web component framework for building modular web applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "default": "./dist/lazy.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "reactive",
    "framework",
    "lightweight",
    "zero-dependency",
    "shadow-dom",
    "lazy-loading",
    "html-components"
  ],
  "scripts": {
    "clean": "rimraf dist dist-cdn coverage",
    "build": "npm run clean && vite build --config vite.npm.config.ts",
    "build:dev": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "build:cdn": "vite build --config vite.cdn.config.ts",
    "build:cdn:dev": "vite build --config vite.cdn.dev.config.ts",
    "watch:cdn": "vite build --config vite.cdn.dev.config.ts --watch",
    "serve:cdn": "npx serve dist-cdn -p 3000 --cors",
    "dev:cdn": "concurrently \"npm run watch:cdn\" \"npm run serve:cdn\"",
    "dev:dotnet": "concurrently \"npm run dev:cdn\" \"cd samples/dotnet-sample && dotnet watch run\"",
    "verify:build": "node scripts/verify-treeshaking.js",
    "build:all": "npm run build && npm run build:cdn && npm run verify:build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build && npm run verify:build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drubiodev/LadrillosJS.git"
  },
  "author": "Daniel Rubio",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/drubiodev/LadrillosJS/issues"
  },
  "homepage": "https://github.com/drubiodev/LadrillosJS#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.2.1",
    "happy-dom": "^15.11.7",
    "rimraf": "^6.0.1",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8"
  }
}
